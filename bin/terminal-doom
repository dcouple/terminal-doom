#!/usr/bin/env bash
# terminal-doom — DOOM inside your terminal.
#
# Chocolate Doom compiled to wasm, served over loopback, drawn into the
# terminal by terminal-browser through the kitty graphics protocol.
set -euo pipefail

VERSION="0.1.0"

# --- locate our own install -------------------------------------------------
# The bin entry is usually a symlink from ~/.local/bin, so follow it before
# resolving web/ relative to the script.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(cd -P "$(dirname "$SELF")" && pwd)/$LINK" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"
WEB="$ROOT/web"

usage() {
  cat <<'USAGE'
Usage: terminal-doom [options]

  terminal-doom                 Play DOOM in this terminal pane
  terminal-doom --split right   Play in a new pane beside what you are doing

Options:
  --split <direction>   Open in a new pane: right, left, down, up
  --size <fraction>     How much space a new split takes (0.2 to 0.95)
  --port <n>            Serve the game on a fixed port instead of an ephemeral one
  --serve               Only start the server, print its url, and stay in the
                        foreground (drive it yourself with terminal-browser)
  --windowed            Keep the browser toolbar and shortcuts, for debugging
  --version             Print the version
  -h, --help            Print this help

Controls:
  arrows / WASD move, ctrl or space fires, e opens doors, 1-7 pick weapons,
  esc for the menu. Quit the pane with ctrl+q.
USAGE
}

SPLIT=""
SIZE=""
PORT="0"
SERVE_ONLY=0
APP_MODE=1

while [ $# -gt 0 ]; do
  case "$1" in
    --split) SPLIT="${2:?--split needs a direction}"; shift 2 ;;
    --split=*) SPLIT="${1#*=}"; shift ;;
    --size) SIZE="${2:?--size needs a fraction}"; shift 2 ;;
    --size=*) SIZE="${1#*=}"; shift ;;
    --port) PORT="${2:?--port needs a number}"; shift 2 ;;
    --port=*) PORT="${1#*=}"; shift ;;
    --serve) SERVE_ONLY=1; shift ;;
    --windowed) APP_MODE=0; shift ;;
    --version) echo "terminal-doom $VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "terminal-doom: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --- dependencies -----------------------------------------------------------
if [ ! -f "$WEB/doom.wasm" ] || [ ! -f "$WEB/doom1.wad" ]; then
  echo "terminal-doom: the game files are missing from $WEB" >&2
  echo "  reinstall, or build them with scripts/build-wasm.sh" >&2
  exit 1
fi

TB="$(command -v terminal-browser || true)"
[ -n "$TB" ] || TB="$HOME/.local/bin/terminal-browser"
if [ ! -x "$TB" ] && [ "$SERVE_ONLY" -eq 0 ]; then
  echo "terminal-doom: terminal-browser is not installed" >&2
  echo "  curl -fsSL https://terminal-browser.sh/install | bash" >&2
  exit 1
fi

# A javascript runtime for the static server. Node if the machine has one,
# otherwise the electron that terminal-browser already vendors, which runs as
# node when asked to. That keeps terminal-doom's only real dependency
# terminal-browser itself.
RUNTIME=()
if command -v node >/dev/null 2>&1; then
  RUNTIME=(node)
else
  ELECTRON="$HOME/.local/share/terminal-browser/app/electron/terminal-browser.app/Contents/MacOS/terminal-browser"
  [ -x "$ELECTRON" ] || ELECTRON="$HOME/.local/share/terminal-browser/app/electron/terminal-browser"
  if [ -x "$ELECTRON" ]; then
    RUNTIME=(env ELECTRON_RUN_AS_NODE=1 "$ELECTRON")
  else
    echo "terminal-doom: no javascript runtime found (install node, or terminal-browser)" >&2
    exit 1
  fi
fi

# --- serve ------------------------------------------------------------------
SERVER_PID=""
cleanup() { [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

PORT_FILE="$(mktemp)"
trap 'cleanup; rm -f "$PORT_FILE"' EXIT INT TERM

"${RUNTIME[@]}" "$WEB/serve.mjs" "$WEB" "$PORT" >"$PORT_FILE" 2>/dev/null &
SERVER_PID=$!

# The server prints its port as soon as it is listening.
BOUND=""
for _ in $(seq 1 100); do
  BOUND="$(head -n1 "$PORT_FILE" 2>/dev/null || true)"
  [ -n "$BOUND" ] && break
  kill -0 "$SERVER_PID" 2>/dev/null || break
  sleep 0.05
done
if [ -z "$BOUND" ]; then
  echo "terminal-doom: the game server did not start" >&2
  exit 1
fi

URL="http://127.0.0.1:$BOUND/"

if [ "$SERVE_ONLY" -eq 1 ]; then
  echo "$URL"
  wait "$SERVER_PID"
  exit 0
fi

# --- play -------------------------------------------------------------------
ARGS=("open" "$URL")
if [ "$APP_MODE" -eq 1 ]; then
  # --app-mode hands every keystroke to the page, which is what a game needs:
  # no toolbar stealing ctrl+r, no overlays drawn over the viewport.
  ARGS+=("--app-mode")
fi
[ -n "$SPLIT" ] && ARGS+=("--split" "$SPLIT")
[ -n "$SIZE" ] && ARGS+=("--size" "$SIZE")

"$TB" "${ARGS[@]}"
